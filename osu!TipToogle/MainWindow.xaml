<Window x:Class="osu_TipToogle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osu! Tablet Auto-Toggle" Height="345" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="TitleBarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="14,6,0,0">
                    <TextBlock Foreground="#E4E4E7" FontSize="17" FontWeight="SemiBold"><Run Text="osu! "/><Run Text="Wacom Pen Tip"/><Run Text=" Auto-Toggle"/></TextBlock>
                    <TextBlock Text="This tool needs shavit's firmware installed in order to work" Foreground="#71717A" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,6,0">
                    <Button Style="{StaticResource TitleBarBtnStyle}" Click="BtnMinimize_Click" Content="—" FontSize="11"/>
                    <Button Style="{StaticResource CloseBtnStyle}" Click="BtnClose_Click" Content="✕" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Cards -->
            <StackPanel Grid.Row="1" Margin="16,16,16,10">
                <!-- Game Status Card -->
                <Border Background="#1C1C21" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="GameStatusDot" Width="12" Height="12" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GAME STATE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtGameStatus" Text="Waiting for osu!..." Foreground="White" FontSize="14" FontWeight="Medium" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtAudioTime" Text="Song timeline: 0 ms" Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tablet Hardware Card -->
                <Border Background="#1C1C21" CornerRadius="10" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="TabletStatusDot" Width="12" Height="12" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TABLET HARDWARE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTabletStatus" Text="Pen Tip &amp; Buttons: Tablet not found" Foreground="White" FontSize="14" FontWeight="Medium" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtDetectedTablet" Text="Device: Searching..." Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2" x:Name="TxtLog" Text="Ready" Foreground="#52525B" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        </Grid>
    </Border>
</Window>