<Window x:Class="osu_TipToggle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osu!TipToggle" Height="340" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="TitleBarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GithubBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="GithubIcon"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Opacity="0.25"
                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GithubIcon"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GithubIcon"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.25"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="14,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="osu! Wacom Pen Tip Auto-Toggle" Foreground="#E4E4E7" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtVersion" Text="v0.0.0" Foreground="#51515A" FontSize="11" FontWeight="Medium" VerticalAlignment="Bottom" Margin="7,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Requires shavit's custom firmware installed." Foreground="#51515A" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,6,0">
                    <Button Style="{StaticResource TitleBarBtnStyle}" Click="BtnMinimize_Click" Content="—" FontSize="11"/>
                    <Button Style="{StaticResource CloseBtnStyle}" Click="BtnClose_Click" Content="✕" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Status Cards -->
            <StackPanel Grid.Row="1" Margin="16,14,16,10">
                <!-- Game Status Card -->
                <Border Background="#1C1C21" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="GameStatusDot" Width="12" Height="12" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GAME STATE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtGameStatus" Text="Waiting for osu! to launch..." Foreground="White" FontSize="14" FontWeight="Medium" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtAudioTime" Text="See you next time..." Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tablet Hardware Card -->
                <Border Background="#1C1C21" CornerRadius="10" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="TabletStatusDot" Width="12" Height="12" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TABLET HARDWARE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTabletStatus" Text="Pressure &amp; Buttons: Tablet not found" Foreground="White" FontSize="14" FontWeight="Medium" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtDetectedTablet" Text="Device: Searching..." Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2" x:Name="TxtLog" Text="Ready" Foreground="#52525B" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="2" x:Name="TxtGithubHint" Text="Open on github.com" Foreground="#A1A1AA" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0" IsHitTestVisible="False"/>

            <!-- GitHub Button (Independent Overlay) -->
            <Button Grid.RowSpan="3"
                    Style="{StaticResource GithubBtnStyle}"
                    Click="BtnGithub_Click"
                    MouseEnter="BtnGithub_MouseEnter"
                    MouseLeave="BtnGithub_MouseLeave"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,14,10"/>
        </Grid>
    </Border>
</Window>